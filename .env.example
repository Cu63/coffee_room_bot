BOT_TOKEN=your-telegram-bot-token-here
DATABASE_URL=postgresql+asyncpg://scorebot:scorebot@db:5432/scorebot
AITUNNEL_API_KEY=sk-aitunnel-xxx
OPENAI_API_KEY=sk-...              # API-ключ для /analyze, /wir и /ff (proxyapi.ru)
OPENSERP_URL=http://openserp:7000
REDIS_URL=redis://redis:6379/0
LOG_CHAT_ID=0
LOG_LEVEL=ERROR

# ── GigaChat: команда /genai (генерация картинок) ────────────────────────────
# Ключ авторизации — это Base64 от строки "<Client ID>:<Client Secret>".
# Где взять:
#   1. Зайти в Studio: https://developers.sber.ru/studio/workspaces
#   2. Создать проект «GigaChat API» (для физлиц — тариф freemium).
#   3. Раздел «Настройки API» → кнопка «Получить ключ» / «Сгенерировать новый ключ».
#      Сбер сразу показывает готовую строку «Авторизационные данные» — её и вставить.
#      Если на руках только Client ID и Client Secret:
#        echo -n "CLIENT_ID:CLIENT_SECRET" | base64 -w0
# Документация: https://developers.sber.ru/docs/ru/gigachat/api/reference/rest/post-token
# Пустое значение = команда /genai не регистрируется, остальной бот работает как обычно.
GIGACHAT_API_KEY=
